              "raw": "{\n  \"teamId\": {{teamId}},\n  \"startTime\": \"2027-03-10T09:00:00.000Z\",\n  \"endTime\": \"2027-03-10T11:30:00.000Z\",\n  \"description\": \"Postman test meeting\",\n  \"room\": \"Green Room\"\n}",
              "options": {
